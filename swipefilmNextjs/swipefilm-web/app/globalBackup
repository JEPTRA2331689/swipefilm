@import "tailwindcss";

:root {
  --font-display: "Playfair Display", serif;
  --font-body: "DM Sans", sans-serif;

  /* Arthouse — vert nuit / crème / rouge ciné */
  --color-bg-primary: #0A130D;
  --color-surface: #111E14;
  --color-surface-alt: #1A2E1E;

  --color-primary: #A03530;
  --color-accent: #C4453A;
  --color-secondary: #D4A94A;

  --color-text-primary: #E8E0C8;
  --color-text-secondary: #6B7A6D;

  --color-error: #E05555;
  --color-success: #4ADE80;
  --color-warning: #D4A94A;

  --color-border: rgba(232, 224, 200, 0.1);
  --color-glass-bg: rgba(17, 30, 20, 0.6);

  --color-swipe-like: #4ADE80;
  --color-swipe-skip: #C4453A;
  --color-swipe-star: #D4A94A;

  --color-nav-bg: rgba(10, 19, 13, 0.92);
  --color-overlay: rgba(10, 19, 13, 0.7);

  --radius-pill: 100px;
  --radius-button: 14px;
  --radius-card: 20px;
  --radius-sheet: 28px;
  --radius-input: 14px;

  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 16px;
  --space-lg: 24px;
  --space-xl: 32px;
  --space-xxl: 48px;
}

.light {
  /* Arthouse light — parchemin / encre / rouge ciné */
  --color-bg-primary: #F5F0E8;
  --color-surface: #EDE8DC;
  --color-surface-alt: #E2DBD0;

  --color-primary: #A03530;
  --color-accent: #C4453A;
  --color-secondary: #A07830;

  --color-text-primary: #1A160A;
  --color-text-secondary: #5A5A48;

  --color-error: #C4453A;
  --color-success: #2D7A4A;
  --color-warning: #A07830;

  --color-border: rgba(26, 22, 10, 0.12);
  --color-glass-bg: rgba(237, 232, 220, 0.7);

  --color-swipe-like: #2D7A4A;
  --color-swipe-skip: #C4453A;
  --color-swipe-star: #A07830;

  --color-nav-bg: rgba(245, 240, 232, 0.95);
  --color-overlay: rgba(26, 22, 10, 0.45);
}

@theme inline {
  --color-bg-primary: var(--color-bg-primary);
  --color-surface: var(--color-surface);
  --color-surface-alt: var(--color-surface-alt);
  --color-primary: var(--color-primary);
  --color-accent: var(--color-accent);
  --color-secondary: var(--color-secondary);
  --color-text-primary: var(--color-text-primary);
  --color-text-secondary: var(--color-text-secondary);
  --color-error: var(--color-error);
  --color-success: var(--color-success);
  --color-warning: var(--color-warning);
  --color-border: var(--color-border);
  --color-swipe-like: var(--color-swipe-like);
  --color-swipe-skip: var(--color-swipe-skip);
  --color-swipe-star: var(--color-swipe-star);

  --font-display: var(--font-display);
  --font-body: var(--font-body);

  --radius-pill: var(--radius-pill);
  --radius-button: var(--radius-button);
  --radius-card: var(--radius-card);
  --radius-sheet: var(--radius-sheet);
  --radius-input: var(--radius-input);
}

@layer base {
  .rounded-pill { border-radius: var(--radius-pill); }
  .rounded-button { border-radius: var(--radius-button); }
  .rounded-card { border-radius: var(--radius-card); }
  .rounded-sheet { border-radius: var(--radius-sheet); }
  .rounded-input { border-radius: var(--radius-input); }
}

body {
  background:
    radial-gradient(ellipse 800px 500px at 10% -5%, rgba(196, 69, 58, 0.07), transparent 55%),
    radial-gradient(ellipse 600px 400px at 90% 5%, rgba(212, 169, 74, 0.05), transparent 50%),
    var(--color-bg-primary);
  color: var(--color-text-primary);
  font-family: var(--font-body), sans-serif;
  min-height: 100vh;
}
@utility pointer-events-mine {
  /* Empêche le drag-and-drop */
  -webkit-user-drag: none; 
  /* Empêche la sélection de texte */
  user-select: none; 
  -webkit-user-select: none;
  /* Empêche l'aperçu de lien sur appui long iOS */
  -webkit-touch-callout: none; 
}

* {
  border-color: var(--color-border);
}

::-webkit-scrollbar {
  height: 6px;
  width: 6px;
}
::-webkit-scrollbar-thumb {
  background: var(--color-surface-alt);
  border-radius: 6px;
}

:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
